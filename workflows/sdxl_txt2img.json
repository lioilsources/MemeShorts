{
  "_doc": "SDXL-rodina txt2img (anime checkpointy: booru tagy). Licence checkpointu ověřit zvlášť.",
  "_params": {
    "ckpt": [["1", "ckpt_name"]], "prompt": [["2", "text"]], "negative": [["3", "text"]], "seed": [["5", "seed"]],
    "width": [["4", "width"]], "height": [["4", "height"]], "batch": [["4", "batch_size"]]
  },
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": ""}},
  "2": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["1", 1]}},
  "3": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["1", 1]}},
  "4": {"class_type": "EmptyLatentImage", "inputs": {"width": 832, "height": 1216, "batch_size": 4}},
  "5": {"class_type": "KSampler", "inputs": {"seed": 42, "steps": 28, "cfg": 5.0, "sampler_name": "euler_ancestral", "scheduler": "normal", "denoise": 1.0, "model": ["1", 0], "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0]}},
  "6": {"class_type": "VAEDecode", "inputs": {"samples": ["5", 0], "vae": ["1", 2]}},
  "7": {"class_type": "SaveImage", "inputs": {"images": ["6", 0], "filename_prefix": "memeshorts/sdxl_t2i"}}
}
