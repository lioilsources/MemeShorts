# LLM (LiteLLM na Sparku přes Cloudflare Access) — classify píše vtipy pro šablony
LLM_BASE_URL=https://llm.ol1n.com
LLM_MODEL=llm-dev
# Cloudflare Access service token (stejný typ jako u AukrofySimulation) — LLM i gen-queue
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Volitelně bearer klíč pro LiteLLM
LLM_API_KEY=

# gen-queue (AiStack) — flux-schnell NIM, v LAN přímo bez CF Access; okna 07–13 a 19–01.
# Fronta je sdílená, na výsledek se čeká i minuty.
GEN_QUEUE_URL=http://192.168.88.66:8091/nim
GEN_TIMEOUT_SECONDS=900
# ComfyUI (jen okno 07–13) — stavba knihovny postav a lab, ne denní roura
COMFY_URL=http://192.168.88.66:8188

# Reddit ingest je za feature flagem (plán 3.1)
MEMESHORTS_REDDIT=0
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=memeshorts/0.1 (by u/ol1n)

# Cesty (relativně k pracovnímu adresáři)
MEMESHORTS_DATA=data
MEMESHORTS_JOBS=jobs
MEMESHORTS_ASSETS=assets
